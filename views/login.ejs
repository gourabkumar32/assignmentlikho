<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    

   
  </style>
</head>

<body class="page-light">
    <%- include('partials/header') %>
    <div class="container">
    <div class="form-container">
    <div class="form-title">Login</div>
    <form action="/login" method="POST">
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <button type="submit" class="form-btn" id="login">Log In</button>
    </form>
    
    <div style="text-align:center; margin: 1.5em 0;">
      <div style="display: flex; align-items: center; margin: 1em 0;">
        <hr style="flex: 1; border: none; border-top: 1px solid #e5e7eb;">
        <span style="margin: 0 1em; color: #6b7280;">or</span>
        <hr style="flex: 1; border: none; border-top: 1px solid #e5e7eb;">
      </div>
      <a href="/auth/google" class="google-login-btn" style="display:inline-flex; align-items:center; background:#fff; color:#222; border:1px solid #e5e7eb; border-radius:8px; padding:0.7em 2em; font-weight:600; text-decoration:none; box-shadow:0 2px 8px rgba(0,0,0,0.06); transition:box-shadow 0.2s;">
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" style="width:22px; margin-right:10px;"> Sign in with Google
      </a>
    </div>
    <div class="text-center mt-3">
        <p class="text-dark">
            Don't have an account? 
            <a href="/signup" class="text-blue-400 hover:text-blue-300">Register</a>
        </p>
    </div>
  </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const hamburger = document.getElementById('hamburger');
      const navLinks = document.getElementById('navLinks');
      if (hamburger && navLinks) {
        hamburger.onclick = () => navLinks.classList.toggle('open');
        navLinks.querySelectorAll('a').forEach(link => {
          link.onclick = () => navLinks.classList.remove('open');
        });
      }
    });
  </script>
</body>
</html>










