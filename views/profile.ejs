<!DOCTYPE html>
<html>
<head>
  <title>Profile</title>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    .profile-hero {
      background: linear-gradient(135deg, #6a44ff 0%, #ff3bfe 100%);
      border-bottom-left-radius: 22px;
      border-bottom-right-radius: 22px;
      padding: 2.5rem 1rem 2rem 1rem;
      text-align: center;
      color: #fff;
      position: relative;
    }
    .profile-hero-img {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #fff;
      margin-top: 1rem;
      background: #fff;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    }
    .profile-hero-initial {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: #fff;
      color: #6a44ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.5rem;
      font-weight: 700;
      margin: 1rem auto 0 auto;
      border: 4px solid #fff;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    }
    .profile-hero-name {
      font-size: 2rem;
      font-weight: 600;
      margin-top: 1rem;
      margin-bottom: 0.25rem;
    }
    .profile-hero-meta {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: #e0e0e0;
    }
    .profile-hero-edit {
      margin-top: 1rem;
      display: flex;
      justify-content: center;
      gap: 1rem;
    }
    .profile-hero-edit .btn {
      background: #fff;
      color: #6a44ff;
      border: none;
      border-radius: 20px;
      padding: 0.5rem 1.5rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: background 0.2s, color 0.2s;
    }
    .profile-hero-edit .btn:hover {
      background: #6a44ff;
      color: #fff;
    }
    .profile-posts-section {
      padding: 2rem 1rem 1rem 1rem;
      max-width: 900px;
      margin: 0 auto;
      
    }
    .profile-posts-title {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      color: #6a44ff;
      text-align: left;
      padding-left: 40px;
    }
    .profile-posts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-bottom: 60px;
      padding-left: 200px;
      padding-right: 200px;
    }
    .profile-assignment-card {
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 2px 12px rgba(106,68,255,0.08);
      padding: 1.2rem 1rem 1rem 1rem;
      color: #222;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-height: 180px;
      position: relative;
    }
    .profile-assignment-title {
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 0.2rem;
    }
    .profile-assignment-date {
      font-size: 0.9rem;
      color: #888;
      margin-bottom: 0.2rem;
    }
    .profile-assignment-status {
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 0.85rem;
      padding: 0.2rem 0.7rem;
      border-radius: 12px;
      background: #f3f4f6;
      color: #6a44ff;
      font-weight: 600;
    }
    .profile-assignment-link {
      color: #6a44ff;
      font-weight: 600;
      text-decoration: underline;
      font-size: 0.98rem;
      margin-top: 0.2rem;
    }
    @media (max-width: 600px) {
      .profile-hero {
        padding: 2rem 0.5rem 1.5rem 0.5rem;
      }
      .profile-posts-section {
        padding: 1.2rem 0.2rem 0.5rem 0.2rem;
        
      }
      .profile-posts-grid {
        gap: 1rem;
        margin-bottom: 60px;
        padding-left: 40px;
      padding-right: 40px;
        
      }
    }
  </style>
</head>
<body class="page-light">
    <%- include('partials/header') %>
    <div class="profile-hero mt-[-20px]">
      <div style="display: flex; justify-content: center; align-items: center;">
        <% if (user.profileImage) { %>
          <img src="/<%= user.profileImage.replace(/^\/+/,'') %>" alt="Profile Image" class="profile-hero-img">
        <% } else { %>
          <div class="profile-hero-initial"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
        <% } %>
      </div>
      <div class="profile-hero-name"><%= user.name %></div>
      <div class="profile-hero-meta">
        <% if (user.college) { %><span><%= user.college %></span><% } %>
        <% if (user.college && user.course) { %> &middot; <% } %>
        <% if (user.course) { %><span><%= user.course %></span><% } %>
      </div>
      <div class="profile-hero-edit">
        <% if (loggedInUser && user._id.toString() === loggedInUser._id.toString()) { %>
          <button id="editProfileBtn" class="btn">Edit Profile</button>
          <form id="editProfileForm" action="/profile/edit" method="POST" enctype="multipart/form-data" style="display:none;">
            <input type="text" name="name" value="<%= user.name %>" class="form-control" required placeholder="Name" style="margin-bottom:0.5rem;">
            <input type="text" name="college" value="<%= user.college %>" class="form-control" placeholder="College Name" style="margin-bottom:0.5rem;">
            <input type="text" name="course" value="<%= user.course %>" class="form-control" placeholder="Course" style="margin-bottom:0.5rem;">
            <input type="file" name="profileImage" accept="image/*" style="margin-bottom:0.5rem;">
            <button type="submit" class="btn" style="margin-right:0.5rem;">Save</button>
            <button type="button" id="cancelEditProfile" class="btn">Cancel</button>
          </form>
        <% } %>
      </div>
    </div>
    <div class="profile-posts-section">
      <div class="profile-posts-title">Posts</div>
      <% if (assignments.length === 0) { %>
        <div>No assignments posted yet.</div>
      <% } %>
      <div class="profile-posts-grid">
        <% assignments.forEach(a => { %>
          <div class="profile-assignment-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <div class="profile-assignment-title"><%= a.title %></div>
               
                <div><%= a.subject %></div>
              <!-- <div><%= a.description %></div> --> 
                <% if (a.attachment) { %>
                  <a href="/uploads/<%= a.attachment %>" target="_blank" class="profile-assignment-link">View File</a>
                <% } %>
              </div>
              <% if (loggedInUser && a.postedBy && a.postedBy.toString() === loggedInUser._id.toString()) { %>
                <div class="assignment-menu-wrapper" style="position: relative;">
                  <button class="assignment-menu-btn" onclick="toggleMenu('<%= a._id %>')" type="button" aria-label="More options">
                    <span style="font-size: 1.5em; font-weight: bold;">&#8942;</span>
                  </button>
                  <div class="assignment-menu" id="menu-<%= a._id %>" style="display: none; position: absolute; right: 0; top: 30px; background: #fff; border: 1px solid #eee; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); z-index: 10; min-width: 120px;">
                    <a href="/assignments/<%= a._id %>/edit" class="assignment-menu-item" style="display: block; padding: 10px 16px; color: #222; text-decoration: none;">Edit</a>
                    <form action="/assignments/<%= a._id %>?_method=DELETE" method="POST" style="margin: 0;">
                      <button type="submit" class="assignment-menu-item" style="display: block; width: 100%; padding: 10px 16px; color: #b91c1c; background: none; border: none; text-align: left; cursor: pointer;">Delete</button>
                    </form>
                  </div>
                </div>
              <% } %>
            </div>
             <div class="profile-assignment-date">Posted on: <%= a.createdAt ? new Date(a.createdAt).toLocaleDateString() : '' %></div>
            <div style="margin-top: 1.2em; text-align: right;">
              <span class="profile-assignment-status"><%= a.status ? a.status.charAt(0).toUpperCase() + a.status.slice(1) : 'Pending' %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

     <a href="https://wa.me/919864855943?text=Hi%20there!%20I%20want%20to%20know%20more%20about%20your%20services" target="_blank" class="whatsapp-float" title="Chat with us on WhatsApp">
        <i class="fa-brands fa-whatsapp fa-3x"></i>
    </a>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('navLinks');
        if (hamburger && navLinks) {
          hamburger.onclick = () => navLinks.classList.toggle('open');
          navLinks.querySelectorAll('a').forEach(link => {
            link.onclick = () => navLinks.classList.remove('open');
          });
        }
        const editBtn = document.getElementById('editProfileBtn');
        const editForm = document.getElementById('editProfileForm');
        const cancelBtn = document.getElementById('cancelEditProfile');
        if(editBtn && editForm && cancelBtn) {
          editBtn.onclick = () => { editForm.style.display = 'block'; editBtn.style.display = 'none'; };
          cancelBtn.onclick = () => { editForm.style.display = 'none'; editBtn.style.display = 'inline-block'; };
        }
      });
      function toggleMenu(id) {
        const menu = document.getElementById('menu-' + id);
        if (menu) {
          menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
          // Hide other open menus
          document.querySelectorAll('.assignment-menu').forEach(m => {
            if (m !== menu) m.style.display = 'none';
          });
        }
      }
      document.addEventListener('click', function(event) {
        if (!event.target.closest('.assignment-menu-wrapper')) {
          document.querySelectorAll('.assignment-menu').forEach(m => m.style.display = 'none');
        }
      });
    </script>
  
</body>
</html>